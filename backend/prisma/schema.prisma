// Prisma schema file
// Based on PRD §6: Skema Database (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int          @id @default(autoincrement())
  nama          String       @db.VarChar(100)
  kode_spg      String       @unique @db.VarChar(20)
  username      String       @unique @db.VarChar(50)
  password_hash String       @db.Text
  outlet_id     Int?
  role          String       @default("spg") @db.VarChar(20) // 'spg' | 'admin'
  created_at    DateTime     @default(now()) @db.Timestamp(6)

  outlet        Outlet?      @relation(fields: [outlet_id], references: [id], onDelete: SetNull)
  attendances   Attendance[]

  @@map("users")
}

model Outlet {
  id           Int          @id @default(autoincrement())
  nama_toko    String       @db.VarChar(100)
  kode_outlet  String       @unique @db.VarChar(20)
  latitude     Float
  longitude    Float
  radius_meter Int          @default(100)

  users        User[]
  attendances  Attendance[]

  @@map("outlets")
}

model Attendance {
  id                     Int       @id @default(autoincrement())
  user_id                Int
  outlet_id              Int
  jenis                  String    @db.VarChar(10) // 'masuk' | 'pulang'
  waktu_server           DateTime  @db.Timestamp(6)
  lat_device             Float?
  long_device            Float?
  jarak_meter            Float?
  mock_location_detected Boolean   @default(false)
  foto_url               String?   @db.Text
  status                 String    @default("valid") @db.VarChar(20) // 'valid' | dll
  created_at             DateTime  @default(now()) @db.Timestamp(6)

  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  outlet                 Outlet    @relation(fields: [outlet_id], references: [id], onDelete: Cascade)

  @@map("attendances")
}
